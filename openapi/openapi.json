                "$ref": "#/components/schemas/TriggerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinishRecordingStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/control/background/relearn": {
      "post": {
        "tags": [
          "Control"
