        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "durationSeconds": {
            "type": "number",
            "format": "double"
          },
          "lineRate": {
            "type": "number",
            "format": "double"
          },
          "hasFrontVideo": {
            "type": "boolean"
          },
          "hasVideoError": {
            "type": "boolean"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "SaveProblem": {
        "required": [
          "code",
          "recordingId",
          "at"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "recordingId": {
            "type": [
              "null",
              "string"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SessionDto": {
        "required": [
          "signedIn"
        ],
        "type": "object",
        "properties": {
          "signedIn": {
            "type": "boolean"
          }
        }
      },
      "SettingsDto": {
        "required": [
          "mediaDirectory",
          "finishCamera",
          "frontCamera",
          "frontCameraEnabled",
          "finishLine",
          "detection"
        ],
        "type": "object",
        "properties": {
          "mediaDirectory": {
            "type": [
              "null",
              "string"
            ]
          },
          "finishCamera": {
            "$ref": "#/components/schemas/CameraSettingsDto"
          },
          "frontCamera": {
            "$ref": "#/components/schemas/CameraSettingsDto"
          },
          "frontCameraEnabled": {
            "type": "boolean"
          },
          "finishLine": {
            "$ref": "#/components/schemas/FinishLineDto"
          },
          "detection": {
            "$ref": "#/components/schemas/DetectionDto"
          }
        }
      },
