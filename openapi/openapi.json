  "components": {
    "schemas": {
      "CameraDevice": {
        "required": [
          "index",
          "name",
          "inUse",
          "deviceName",
          "devicePath",
          "modes"
        ],
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "inUse": {
            "type": "boolean"
          },
          "deviceName": {
            "type": [
              "null",
              "string"
            ]
          },
          "devicePath": {
            "type": [
              "null",
              "string"
            ]
          },
          "modes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CameraMode"
            }
          }
        }
      },
      "CameraMode": {
        "required": [
          "width",
          "height",
          "frameRate",
          "format"
        ],
        "type": "object",
        "properties": {
          "width": {
            "type": "integer",
            "format": "int32"
          },
          "height": {
            "type": "integer",
            "format": "int32"
          },
          "frameRate": {
            "type": "number",
            "format": "double"
          },
          "format": {
            "type": "string"
          }
        }
      },
      "CameraSettingsDto": {
        "required": [
          "deviceIndex",
          "width",
          "height",
          "frameRate",
          "exposure",
          "offsetMs"
        ],
        "type": "object",
        "properties": {
          "deviceIndex": {
            "type": "integer",
            "format": "int32"
          },
          "width": {
            "type": "integer",
            "format": "int32"
          },
          "height": {
            "type": "integer",
            "format": "int32"
          },
          "frameRate": {
            "type": "integer",
            "format": "int32"
          },
          "exposure": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "offsetMs": {
            "type": "integer",
            "format": "int32"
          },
          "deviceName": {
            "type": [
              "null",
              "string"
            ]
          },
          "devicePath": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CameraState": {
        "enum": [
          "Off",
          "Disabled",
          "Starting",
          "Running",
          "Error"
        ]
      },
      "CameraStatus": {
        "required": [
          "state",
          "errorCode",
          "measuredFrameRate",
          "configuredFrameRate"
        ],
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/CameraState"
          },
          "errorCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "measuredFrameRate": {
            "type": "number",
            "format": "double"
          },
          "configuredFrameRate": {
            "type": "integer",
            "format": "int32"
          },
          "warningCode": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DetectionDto": {
        "required": [
          "pixelThreshold",
          "occupancyThresholdPercent",
          "preRollSeconds",
          "postRollSeconds",
          "maxDurationSeconds",
          "frontPreRollSeconds",
          "frontPostRollSeconds"
        ],
        "type": "object",
        "properties": {
          "pixelThreshold": {
            "type": "integer",
            "format": "int32"
          },
          "occupancyThresholdPercent": {
            "type": "number",
            "format": "double"
          },
          "preRollSeconds": {
            "type": "number",
            "format": "double"
          },
          "postRollSeconds": {
            "type": "number",
            "format": "double"
          },
          "maxDurationSeconds": {
            "type": "number",
            "format": "double"
          },
          "frontPreRollSeconds": {
            "type": "number",
            "format": "double"
          },
          "frontPostRollSeconds": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "FinishEventEnd": {
        "enum": [
          "PostRoll",
          "MaxDuration",
          "Stopped"
        ]
      },
      "FinishLineDto": {
        "required": [
          "rotation",
          "position",
          "width",
          "reverseTimeDirection"
        ],
        "type": "object",
        "properties": {
          "rotation": {
            "$ref": "#/components/schemas/ImageRotation"
          },
          "position": {
            "type": "integer",
            "format": "int32"
          },
          "width": {
            "type": "integer",
            "format": "int32"
          },
          "reverseTimeDirection": {
            "type": "boolean"
          }
        }
      },
      "FinishRecordingStatus": {
        "required": [
          "mode",
          "finishCamera",
          "frontCamera",
          "line",
          "overlay",
          "pendingSaves",
          "lastProblem",
          "serverTime"
        ],
        "type": "object",
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/OperatingMode"
          },
          "finishCamera": {
            "$ref": "#/components/schemas/CameraStatus"
          },
          "frontCamera": {
            "$ref": "#/components/schemas/CameraStatus"
          },
          "line": {
            "$ref": "#/components/schemas/LineStatus"
          },
          "overlay": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LineOverlay"
              }
            ]
          },
          "pendingSaves": {
            "type": "integer",
            "format": "int32"
          },
          "lastProblem": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SaveProblem"
              }
            ]
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FrontVideoInfo": {
        "required": [
          "available",
          "errorCode",
          "frameRate",
          "frameTimestamps"
        ],
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          },
          "errorCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "frameRate": {
            "type": "number",
            "format": "double"
          },
          "frameTimestamps": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      },
      "ImageRotation": {
        "enum": [
          "None",
          "Clockwise90",
          "CounterClockwise90",
          "Rotate180"
        ]
      },
      "LineOverlay": {
        "required": [
          "position",
          "width"
        ],
        "type": "object",
        "properties": {
          "position": {
            "type": "number",
            "format": "double"
          },
          "width": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "LineState": {
        "enum": [
          "Free",
          "Occupied",
          "Recording"
        ]
      },
      "LineStatus": {
        "required": [
          "state",
          "occupancyPercent",
          "lineRate",
          "lineRateWarning",
          "manualTrigger",
          "backgroundLearning",
          "eventRunning",
          "eventStartedAt",
          "detectedEvents"
        ],
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/LineState"
          },
          "occupancyPercent": {
            "type": "number",
            "format": "double"
          },
          "lineRate": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "lineRateWarning": {
            "type": "boolean"
          },
          "manualTrigger": {
            "type": "boolean"
          },
          "backgroundLearning": {
            "type": "boolean"
          },
          "eventRunning": {
            "type": "boolean"
          },
          "eventStartedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "detectedEvents": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "pin"
        ],
        "type": "object",
        "properties": {
          "pin": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "OperatingMode": {
        "enum": [
          "Stopped",
          "Preview",
          "Recording"
        ]
      },
      "PreviewKind": {
        "enum": [
          "FinishCamera",
          "FrontCamera",
          "FinishStrip"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RecordingFile": {
        "enum": [
          "FinishImage",
          "FinishVideo",
          "FrontVideo"
        ]
      },
      "RecordingMetadata": {
        "required": [
          "id",
          "startedAt",
          "endedAt",
          "eventStartedAt",
          "eventEndedAt",
          "endReason",
          "lineRate",
          "reverseTimeDirection",
          "imageWidth",
          "imageHeight",
          "timelineHeight",
          "columnTimestamps",
          "finishVideo",
          "frontVideo",
          "finishOffsetMs",
          "frontOffsetMs"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "endedAt": {
            "type": "string",
            "format": "date-time"
          },
          "eventStartedAt": {
            "type": "string",
            "format": "date-time"
          },
          "eventEndedAt": {
            "type": "string",
            "format": "date-time"
          },
          "endReason": {
            "$ref": "#/components/schemas/FinishEventEnd"
          },
          "lineRate": {
            "type": "number",
            "format": "double"
          },
          "reverseTimeDirection": {
            "type": "boolean"
          },
          "imageWidth": {
            "type": "integer",
            "format": "int32"
          },
          "imageHeight": {
            "type": "integer",
            "format": "int32"
          },
          "timelineHeight": {
            "type": "integer",
            "format": "int32"
          },
          "columnTimestamps": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "finishVideo": {
            "$ref": "#/components/schemas/VideoInfo"
          },
          "frontVideo": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/FrontVideoInfo"
              }
            ]
          },
          "finishOffsetMs": {
            "type": "integer",
            "format": "int32"
          },
          "frontOffsetMs": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "RecordingSummary": {
        "required": [
          "id",
          "startedAt",
          "durationSeconds",
          "lineRate",
          "hasFrontVideo",
          "hasVideoError",
          "sizeBytes"
